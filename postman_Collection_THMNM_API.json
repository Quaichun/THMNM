            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": {\n    \"username\": \"test_user\",\n    \"fullname\": \"Test User\",\n    \"email\": \"test_user@example.com\",\n    \"password\": \"123456\"\n  }\n}"
            },
            "url": {
